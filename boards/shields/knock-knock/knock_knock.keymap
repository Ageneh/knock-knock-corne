#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
/* #include <dt-bindings/zmk/studio_unlock.h> */

/* #include "includes/settings.dtsi" */
#include "includes/combos.dtsi"
#include "includes/homerow_mods.dtsi"

#define BASE   0
#define LOWER  1
#define RAISE  2
#define SYSTEM 3

/ {

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
//    ┌──────┬──────────────┬──────────────┬──────────────┬────────────────────┬─────┐           ┌─────┬────────────────────┬──────────────┬──────────────┬──────────────┬───────────┐
//    │ bspc │      Q       │      W       │      E       │         R          │  T  │           │  Z  │         U          │      I       │      O       │      P       │     \     │
//    ├──────┼──────────────┼──────────────┼──────────────┼────────────────────┼─────┤           ├─────┼────────────────────┼──────────────┼──────────────┼──────────────┼───────────┤
//    │ tab  │ &hm_l lctl A │ &hm_l lalt S │ &hm_l lgui D │ &hm_shift_l lsft F │  G  │           │  H  │ &hm_shift_r rsft J │ &hm_r rgui K │ &hm_r ralt L │ &hm_r rctl ; │     '     │
//    ├──────┼──────────────┼──────────────┼──────────────┼────────────────────┼─────┤           ├─────┼────────────────────┼──────────────┼──────────────┼──────────────┼───────────┤
//    │ esc  │      Y       │      X       │      C       │         V          │  B  │           │  N  │         M          │      ,       │      .       │      /       │ mo SYSTEM │
//    └──────┴──────────────┴──────────────┼──────────────┼────────────────────┼─────┤           ├─────┼────────────────────┼──────────────┼──────────────┴──────────────┴───────────┘
//                                         │  mo raltISE  │        lgui        │ spc │           │ ent │  &hm_r ralt bspc   │ &hm_r rctl = │
//                                         └──────────────┴────────────────────┴─────┘           └─────┴────────────────────┴──────────────┘
  &kp BSPC   &kp Q           &kp W          &kp E          &kp R                  &kp T                   &kp Z       &kp U                  &kp I               &kp O               &kp P                   &kp BSLH
  &kp TAB    &hm_l LCTRL A   &hm_l LALT S   &hm_l LCMD D   &hm_shift_l LSHIFT F   &kp G                   &kp H       &hm_shift_r RSHIFT J   &hm_r RIGHT_GUI K   &hm_r RIGHT_ALT L   &hm_r RCTRL SEMICOLON   &kp SQT
  &kp ESC    &kp Y           &kp X          &kp C          &kp V                  &kp B                   &kp N       &kp M                  &kp COMMA           &kp PERIOD          &kp SLASH               &mo SYSTEM
                                            &mo RAISE      &kp LCMD               &kp SPACE               &kp ENTER   &hm_r RALT BSPC        &hm_r RCTRL EQUAL
            >;
        };

        raise {
            display-name = "Raise";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬──────────┐           ┌─────┬──────┬──────┬─────┬──────┬─────┐
//    │ del │  1  │  2  │  3  │  4  │    5     │           │  6  │  7   │  8   │  9  │  0   │     │
//    ├─────┼─────┼─────┼─────┼─────┼──────────┤           ├─────┼──────┼──────┼─────┼──────┼─────┤
//    │     │     │     │     │     │          │           │     │ left │ down │ up  │ rght │     │
//    ├─────┼─────┼─────┼─────┼─────┼──────────┤           ├─────┼──────┼──────┼─────┼──────┼─────┤
//    │     │     │     │     │     │          │           │     │      │      │     │      │     │
//    └─────┴─────┴─────┼─────┼─────┼──────────┤           ├─────┼──────┼──────┼─────┴──────┴─────┘
//                      │     │     │ mo LOWER │           │     │ del  │      │
//                      └─────┴─────┴──────────┘           └─────┴──────┴──────┘
  &kp DEL   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp NUMBER_4   &kp N5                  &kp NUMBER_6   &kp N7     &kp N8     &kp N9   &kp N0      &trans
  &trans    &trans         &trans         &trans         &trans         &trans                  &trans         &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &trans
  &trans    &trans         &trans         &trans         &trans         &trans                  &trans         &trans     &trans     &trans   &trans      &trans
                                          &trans         &trans         &mo LOWER               &trans         &kp DEL    &trans
            >;
        };

        lower {
            bindings = <
//    ┌─────┬──────┬──────┬──────┬──────┬──────┐           ┌─────┬──────┬─────┬─────┬─────┬─────┐
//    │     │  f1  │  f2  │  f3  │  f4  │  f5  │           │ f6  │  f7  │ f8  │ f9  │ f10 │     │
//    ├─────┼──────┼──────┼──────┼──────┼──────┤           ├─────┼──────┼─────┼─────┼─────┼─────┤
//    │     │ volu │ bri+ │ prev │ play │ next │           │     │ home │     │     │ end │     │
//    ├─────┼──────┼──────┼──────┼──────┼──────┤           ├─────┼──────┼─────┼─────┼─────┼─────┤
//    │     │ vold │ bri- │      │      │      │           │     │      │     │     │     │     │
//    └─────┴──────┴──────┼──────┼──────┼──────┤           ├─────┼──────┼─────┼─────┴─────┴─────┘
//                        │ f11  │ mo 3 │      │           │     │      │ f12 │
//                        └──────┴──────┴──────┘           └─────┴──────┴─────┘
  &trans   &kp F1            &kp F2         &kp F3       &kp F4     &kp F5                   &kp F6   &kp F7     &kp F8    &kp F9   &kp F10   &trans
  &trans   &kp C_VOLUME_UP   &kp C_BRI_UP   &kp C_PREV   &kp C_PP   &kp C_NEXT               &trans   &kp HOME   &trans    &trans   &kp END   &trans
  &trans   &kp C_VOL_DN      &kp C_BRI_DN   &trans       &trans     &trans                   &trans   &trans     &trans    &trans   &trans    &trans
                                            &kp F11      &mo 3      &trans                   &trans   &trans     &kp F12
            >;

            label = "Lower";
        };

        system {
            bindings = <
//    ┌────────────────┬──────────┬──────────┬──────────┬──────┬────────────┐           ┌─────┬────────────────┬────────────────┬──────────────┬────────────────┬─────┐
//    │                │ bt_sel 0 │ bt_sel 1 │ bt_sel 2 │      │            │           │     │    ralt(U)     │                │   ralt(O)    │                │     │
//    ├────────────────┼──────────┼──────────┼──────────┼──────┼────────────┤           ├─────┼────────────────┼────────────────┼──────────────┼────────────────┼─────┤
//    │                │ ralt(A)  │          │   lclk   │ rclk │            │           │     │ &mmv MOVE_left │ &mmv MOVE_down │ &mmv MOVE_up │ &mmv MOVE_rght │     │
//    ├────────────────┼──────────┼──────────┼──────────┼──────┼────────────┤           ├─────┼────────────────┼────────────────┼──────────────┼────────────────┼─────┤
//    │ &studio_unlock │          │          │          │      │ bt_clr_ALL │           │     │                │                │              │   &sys_reset   │     │
//    └────────────────┴──────────┴──────────┼──────────┼──────┼────────────┤           ├─────┼────────────────┼────────────────┼──────────────┴────────────────┴─────┘
//                                           │          │      │            │           │     │                │ &studio_unlock │
//                                           └──────────┴──────┴────────────┘           └─────┴────────────────┴────────────────┘
  &trans           &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans     &trans                       &trans   &kp RA(U)        &trans           &kp RA(O)      &trans            &trans
  &trans           &kp RA(A)      &trans         &mkp MB1       &mkp MB2   &trans                       &trans   &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &trans
  &studio_unlock   &trans         &trans         &trans         &trans     &bt BT_CLR_ALL               &trans   &trans           &trans           &trans         &sys_reset        &trans
                                                 &trans         &trans     &trans                       &trans   &trans           &studio_unlock
            >;

            label = "System";
        };
    };
};
