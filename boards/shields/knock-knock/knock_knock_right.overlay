#include "knock_knock.dtsi"

&kscan0 {
    // Right half not yet wired. These mirror the left half, assuming symmetric
    // wiring to the same pro_micro pins. Verify against your right-half build
    // and adjust the pin list if it differs.
    col-gpios
        = <&pro_micro 21 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 10 GPIO_ACTIVE_HIGH>
        , <&pro_micro 2 GPIO_ACTIVE_HIGH>
        , <&pro_micro 9 GPIO_ACTIVE_HIGH>
        ;
};

&default_transform {
    // Shift right-half physical columns into logical columns 6-11.
    // Equals the number of columns in the left half.
    col-offset = <6>;
};
